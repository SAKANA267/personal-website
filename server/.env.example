# HTTP 服务端口
PORT=3000

# MySQL 连接
DB_HOST=localhost
DB_PORT=3306
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=personal_website

# express-session 密钥
SESSION_SECRET=change-this-to-a-random-secret

# 管理员白名单（逗号分隔的用户名）：devlog 写入 / 留言审核 / 删除任意分享仅限这些账号
ADMIN_USERNAMES=changeme

# WebSocket 聊天服务器
WS_PORT=9000
WS_USE_SSL=false
# 生产环境开启 wss 时提供证书路径（相对 server 目录）：
# WS_CERT_PATH=certs/server.pem
# WS_KEY_PATH=certs/server.key

# 二维码分享：单文件上传上限（MB）。生产 nginx 的 client_max_body_size 需同步 ≥ 此值
SHARE_MAX_MB=20

# 博客插图：单图上传上限（MB），默认 8。需 ≤ nginx 的 client_max_body_size
BLOG_IMAGE_MAX_MB=8

# 个人主页头像：单文件上传上限（MB），默认 2（服务端统一重编码为 256×256 WebP）。
# 需 ≤ nginx 的 client_max_body_size
AVATAR_MAX_MB=2

# ALTCHA 人机验证（登录/注册页 PoW 验证码）的挑战签名密钥：随机长串即可。
# 未配置时自动改用进程级随机密钥（重启仅作废在途挑战，不影响功能），生产建议显式设置
ALTCHA_HMAC_KEY=change-this-to-a-random-secret

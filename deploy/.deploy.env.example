# 部署目标配置 —— 复制为 .deploy.env 并填写（.deploy.env 已被 gitignore，不会提交）。
#   cp deploy/.deploy.env.example deploy/.deploy.env

# 服务器地址（IP 或域名）
DEPLOY_HOST=sakana267.online

# SSH 登录用户（建议使用非 root 的专用部署用户）
DEPLOY_USER=root

# 服务器上的部署根目录（脚本会自动创建）。
# 注意：目录结构必须是 <DEPLOY_DIR>/server 与 <DEPLOY_DIR>/client/dist 同级，
# 否则 server/src/index.ts 里 '../../client/dist' 的相对路径会失效。
DEPLOY_DIR=/www/wwwroot/personal-website

# pm2 应用名（与 ecosystem.config.cjs 里的 name 保持一致）
PM2_APP=personal-website

# SSH 端口（非 22 时取消注释并填写）
# SSH_PORT=22

# 若服务器上 node/npm/pm2 不在非交互 ssh 的默认 PATH（很常见，例如用 nvm 或宝塔安装），
# 在这里用绝对路径指定（在服务器上执行 `which node` / `which pm2` 可查到）：
# NODE_BIN=/www/server/nodejs/current/bin/node
# NPM_BIN=/www/server/nodejs/current/bin/npm
# PM2_BIN=/www/server/nodejs/current/bin/pm2
